# The keys the app reads. Set them in Cloudflare Pages (Production and Preview) from the leftovers-prd project.
# Local development doesn't need them: `pnpm dev` reads the local Supabase stack's keys at run time.
# Only the browser-safe publishable/anon key belongs here, never the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
